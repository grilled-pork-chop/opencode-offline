{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "my_provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "My Private LLM",
      "options": {
        "baseURL": "http://your-llm-server:8080/v1",
        "apiKey": "your-api-key"
      },
      "models": {
        "your-model-id": {
          "name": "Your Model Name",
          "attachment": false,
          "reasoning": false
        }
      }
    }
  },
  "model": "my_provider/your-model-id"
}
