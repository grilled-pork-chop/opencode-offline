#!/usr/bin/env bash
# =============================================================================
# opencode-offline — Install, configure, and manage OpenCode offline
# =============================================================================
# Usage:
#   ./opencode-offline install              Install from bundle (offline)
#   ./opencode-offline config               Change provider URL / model
#   ./opencode-offline status               Show current configuration
#   ./opencode-offline uninstall            Remove installation
# =============================================================================
set -euo pipefail

# ─── Constants ───────────────────────────────────────────────────────────────
readonly VERSION="1.0.0"
readonly NODE_VERSION="v22.16.0"
readonly INSTALL_BASE="$HOME/.opencode"
readonly CONFIG_DIR="$HOME/.config/opencode"
readonly CACHE_DIR="$HOME/.opencode/cache"
readonly CONFIG_FILE="$CONFIG_DIR/opencode.json"
readonly ENV_FILE="$INSTALL_BASE/env.sh"

readonly DEFAULT_PROVIDER_URL="http://localhost:8000/v1"
readonly DEFAULT_MODEL_NAME="deepseek-v32"

# ─── Colors ──────────────────────────────────────────────────────────────────
readonly RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m' CYAN='\033[0;36m' BOLD='\033[1m' NC='\033[0m'

log_ok()    { echo -e "  ${GREEN}✓${NC} $*"; }
log_warn()  { echo -e "  ${YELLOW}!${NC} $*"; }
log_err()   { echo -e "  ${RED}✗${NC} $*"; }
log_step()  { echo -e "\n${BLUE}▸${NC} ${BOLD}$*${NC}"; }

header() {
    echo ""
    echo -e "${CYAN}  opencode-offline ${VERSION}${NC} — $1"
    echo ""
}

# ─── Helpers ─────────────────────────────────────────────────────────────────
read_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        CURRENT_URL=$(grep -oP '"baseURL"\s*:\s*"\K[^"]+' "$CONFIG_FILE" 2>/dev/null || echo "")
        CURRENT_MODEL=$(grep -oP '"model"\s*:\s*"local/\K[^"]+' "$CONFIG_FILE" 2>/dev/null || echo "")
    else
        CURRENT_URL=""
        CURRENT_MODEL=""
    fi
}

prompt_provider() {
    local default_url="${1:-$DEFAULT_PROVIDER_URL}"
    local default_model="${2:-$DEFAULT_MODEL_NAME}"

    echo "  Provider examples:"
    echo "    Ollama:       http://localhost:11434/v1"
    echo "    vLLM:         http://localhost:8000/v1"
    echo "    LM Studio:    http://localhost:1234/v1"
    echo "    Text Gen UI:  http://localhost:5000/v1"
    echo ""
    read -rp "  Provider URL [${default_url}]: " PROVIDER_URL
    PROVIDER_URL="${PROVIDER_URL:-$default_url}"

    echo ""
    echo "  Model examples: deepseek-v32, qwen3-coder:30b, devstral-small-2:24b"
    echo ""
    read -rp "  Model name [${default_model}]: " MODEL_NAME
    MODEL_NAME="${MODEL_NAME:-$default_model}"
    echo ""
}

# =============================================================================
# INSTALL
# =============================================================================
cmd_install() {
    header "Installing OpenCode"

    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    # ── Provider configuration ───────────────────────────────────────────
    log_step "Provider configuration"
    prompt_provider
    echo -e "  URL:   ${CYAN}${PROVIDER_URL}${NC}"
    echo -e "  Model: ${CYAN}${MODEL_NAME}${NC}"

    # ── Node.js ──────────────────────────────────────────────────────────
    log_step "Installing Node.js"
    local node_archive="$script_dir/node/node-${NODE_VERSION}-linux-x64.tar.xz"
    if [[ ! -f "$node_archive" ]]; then
        log_err "Node.js archive not found: $node_archive"
        exit 1
    fi
    mkdir -p "$INSTALL_BASE/node"
    tar -xJf "$node_archive" -C "$INSTALL_BASE/node" --strip-components=1
    log_ok "Node.js → $INSTALL_BASE/node"

    # ── OpenCode binary ──────────────────────────────────────────────────
    log_step "Installing OpenCode"
    local binary="$script_dir/bin/opencode"
    if [[ ! -f "$binary" ]]; then
        log_err "OpenCode binary not found: $binary"
        exit 1
    fi
    mkdir -p "$INSTALL_BASE/bin"
    cp "$binary" "$INSTALL_BASE/bin/"
    chmod +x "$INSTALL_BASE/bin/opencode"

    # Install this CLI alongside opencode for config/status/uninstall
    cp "${BASH_SOURCE[0]}" "$INSTALL_BASE/bin/opencode-offline"
    chmod +x "$INSTALL_BASE/bin/opencode-offline"
    log_ok "OpenCode → $INSTALL_BASE/bin"

    # ── npm dependencies ─────────────────────────────────────────────────
    log_step "Installing dependencies"
    if [[ -d "$script_dir/deps/opencode/node_modules" ]]; then
        mkdir -p "$CACHE_DIR"
        cp -r "$script_dir/deps/opencode/node_modules" "$CACHE_DIR/"
        cp "$script_dir/deps/opencode/package.json" "$CACHE_DIR/"
        log_ok "Dependencies → $CACHE_DIR/node_modules"
    fi

    # ── Configuration ────────────────────────────────────────────────────
    log_step "Writing configuration"
    mkdir -p "$CONFIG_DIR" "$CACHE_DIR"

    if [[ -f "$CONFIG_FILE" ]]; then
        cp "$CONFIG_FILE" "$CONFIG_FILE.bak"
        log_warn "Backed up existing opencode.json"
    fi

    sed -e "s|__PROVIDER_URL__|${PROVIDER_URL}|g" \
        -e "s|__MODEL_NAME__|${MODEL_NAME}|g" \
        "$script_dir/config/opencode.json" > "$CONFIG_FILE"
    log_ok "opencode.json (${PROVIDER_URL}, ${MODEL_NAME})"

    if [[ -f "$script_dir/config/api.json" ]]; then
        cp "$script_dir/config/api.json" "$CACHE_DIR/"
        log_ok "Models API cache"
    else
        log_warn "api.json not found — OpenCode may try to fetch models online"
    fi

    # ── Environment ──────────────────────────────────────────────────────
    log_step "Setting up environment"
    cat > "$ENV_FILE" << 'EOF'
# OpenCode Offline Environment
export PATH="$HOME/.opencode/bin:$HOME/.opencode/node/bin:$PATH"
export OPENCODE_MODELS_URL="file://$HOME/.opencode/cache"
export NODE_PATH="$HOME/.opencode/cache/node_modules:$HOME/.config/opencode/node_modules"
EOF

    local shell_rc=""
    if [[ "${SHELL:-}" == *"zsh"* ]]; then
        shell_rc="$HOME/.zshrc"
    elif [[ "${SHELL:-}" == *"bash"* ]]; then
        shell_rc="$HOME/.bashrc"
    fi

    if [[ -n "$shell_rc" && -f "$shell_rc" ]]; then
        if ! grep -qF ".opencode/env.sh" "$shell_rc" 2>/dev/null; then
            printf '\n# OpenCode Offline\nsource "$HOME/.opencode/env.sh"\n' >> "$shell_rc"
            log_ok "Added to $shell_rc"
        else
            log_ok "Already in $shell_rc"
        fi
    fi

    # Source for current session
    source "$ENV_FILE"
    log_ok "Environment loaded"

    # ── Verify ───────────────────────────────────────────────────────────
    log_step "Verifying"
    local errors=0

    if [[ -x "$INSTALL_BASE/bin/opencode" ]]; then
        local ver
        ver=$("$INSTALL_BASE/bin/opencode" --version 2>/dev/null || echo "unknown")
        log_ok "OpenCode: ${ver}"
    else
        log_err "OpenCode binary missing"
        ((errors++))
    fi

    if [[ -x "$INSTALL_BASE/node/bin/node" ]]; then
        log_ok "Node.js: $("$INSTALL_BASE/node/bin/node" --version 2>/dev/null)"
    else
        log_err "Node.js missing"
        ((errors++))
    fi

    [[ -f "$CONFIG_FILE" ]]        && log_ok "opencode.json"    || log_warn "Config missing"
    [[ -f "$CACHE_DIR/api.json" ]] && log_ok "Models API cache" || log_warn "Models cache missing"

    if (( errors > 0 )); then
        echo ""
        log_err "Installation completed with errors"
        exit 1
    fi

    # ── Summary ──────────────────────────────────────────────────────────
    echo ""
    echo -e "  ${GREEN}${BOLD}Installation complete!${NC}"
    echo ""
    echo "  Paths:"
    echo "    Binary:  $INSTALL_BASE/bin/opencode"
    echo "    Node.js: $INSTALL_BASE/node/"
    echo "    Config:  $CONFIG_DIR/"
    echo "    Cache:   $CACHE_DIR/"
    echo ""
    echo "  Provider:"
    echo "    URL:   ${PROVIDER_URL}"
    echo "    Model: ${MODEL_NAME}"
    echo ""
    echo "  Then run:"
    echo "    opencode"
    echo ""
    echo "  Later:"
    echo "    opencode-offline config       Change provider/model"
    echo "    opencode-offline status       Show current config"
    echo ""
    echo "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  IMPORTANT:"
    echo "    1. Ensure ${PROVIDER_URL} is running and accessible"
    echo "    2. Model '${MODEL_NAME}' must be available at that endpoint"
    echo "    3. Context window should be 32k+ for best results"
    echo "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

# =============================================================================
# CONFIG
# =============================================================================
cmd_config() {
    header "Reconfigure provider"

    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_err "Not installed. Run: opencode-offline install"
        exit 1
    fi

    read_config

    echo -e "  Current URL:   ${YELLOW}${CURRENT_URL:-not set}${NC}"
    echo -e "  Current Model: ${YELLOW}${CURRENT_MODEL:-not set}${NC}"
    echo ""

    prompt_provider "${CURRENT_URL:-$DEFAULT_PROVIDER_URL}" "${CURRENT_MODEL:-$DEFAULT_MODEL_NAME}"

    if [[ "$PROVIDER_URL" == "$CURRENT_URL" && "$MODEL_NAME" == "$CURRENT_MODEL" ]]; then
        log_ok "No changes"
        return
    fi

    cp "$CONFIG_FILE" "$CONFIG_FILE.bak"

    if [[ "$PROVIDER_URL" != "$CURRENT_URL" && -n "$CURRENT_URL" ]]; then
        local old_esc new_esc
        old_esc=$(printf '%s' "$CURRENT_URL" | sed 's/[&/\]/\\&/g')
        new_esc=$(printf '%s' "$PROVIDER_URL" | sed 's/[&/\]/\\&/g')
        sed -i "s|${old_esc}|${new_esc}|g" "$CONFIG_FILE"
        log_ok "URL: ${CURRENT_URL} → ${PROVIDER_URL}"
    fi

    if [[ "$MODEL_NAME" != "$CURRENT_MODEL" && -n "$CURRENT_MODEL" ]]; then
        sed -i "s|${CURRENT_MODEL}|${MODEL_NAME}|g" "$CONFIG_FILE"
        log_ok "Model: ${CURRENT_MODEL} → ${MODEL_NAME}"
    fi

    read_config
    echo ""
    echo -e "  ${GREEN}${BOLD}Updated:${NC}"
    echo -e "    URL:   ${CYAN}${CURRENT_URL}${NC}"
    echo -e "    Model: ${CYAN}${CURRENT_MODEL}${NC}"
    echo ""
}

# =============================================================================
# STATUS
# =============================================================================
cmd_status() {
    header "Status"

    if [[ -x "$INSTALL_BASE/bin/opencode" ]]; then
        local ver
        ver=$("$INSTALL_BASE/bin/opencode" --version 2>/dev/null || echo "unknown")
        log_ok "OpenCode: ${ver}"
    else
        log_err "OpenCode: not installed"
    fi

    if [[ -x "$INSTALL_BASE/node/bin/node" ]]; then
        log_ok "Node.js: $("$INSTALL_BASE/node/bin/node" --version 2>/dev/null)"
    else
        log_err "Node.js: not installed"
    fi

    if [[ -f "$CONFIG_FILE" ]]; then
        read_config
        echo ""
        echo -e "  Provider URL:  ${CYAN}${CURRENT_URL:-not set}${NC}"
        echo -e "  Model:         ${CYAN}${CURRENT_MODEL:-not set}${NC}"
        echo -e "  Config:        ${CONFIG_FILE}"
    else
        echo ""
        log_err "No configuration found"
    fi

    [[ -f "$CACHE_DIR/api.json" ]] && log_ok "Models API cache" || log_warn "Models cache missing"

    echo ""
    echo "  Paths:"
    echo "    Binary:  $INSTALL_BASE/bin/"
    echo "    Node.js: $INSTALL_BASE/node/"
    echo "    Config:  $CONFIG_DIR/"
    echo "    Cache:   $CACHE_DIR/"
    echo ""
}

# =============================================================================
# UNINSTALL
# =============================================================================
cmd_uninstall() {
    header "Uninstall"

    echo "  This will remove:"
    echo "    $INSTALL_BASE"
    echo "    $CONFIG_DIR"
    echo ""

    read -rp "  Continue? [y/N]: " confirm
    if [[ "${confirm,,}" != "y" ]]; then
        echo "  Cancelled"
        return
    fi

    rm -rf "$INSTALL_BASE" "$CONFIG_DIR"

    for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
        if [[ -f "$rc" ]] && grep -qF ".opencode/env.sh" "$rc" 2>/dev/null; then
            sed -i '/# OpenCode Offline/d; /\.opencode\/env\.sh/d' "$rc"
            log_ok "Cleaned $rc"
        fi
    done

    log_ok "Removed"
    echo ""
}

# =============================================================================
# MAIN
# =============================================================================
usage() {
    echo ""
    echo -e "${CYAN}  opencode-offline ${VERSION}${NC}"
    echo ""
    echo "  Usage: opencode-offline <command>"
    echo ""
    echo "  Commands:"
    echo "    install     Install from bundle (offline target)"
    echo "    config      Change provider URL / model"
    echo "    status      Show current configuration"
    echo "    uninstall   Remove installation"
    echo ""
}

main() {
    local cmd="${1:-}"

    case "$cmd" in
        install)    cmd_install ;;
        config)     cmd_config ;;
        status)     cmd_status ;;
        uninstall)  cmd_uninstall ;;
        -h|--help)  usage ;;
        *)          usage; exit 1 ;;
    esac
}

main "$@"